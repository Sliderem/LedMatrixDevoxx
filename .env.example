# Copy this file to .env and fill in your key. .env is git-ignored.
# Environment variables take precedence over .env.

# OpenAI API key, used for AI image generation from a text prompt.
CHATGPT_API_KEY=

# Optional: override the image model (default: gpt-image-1).
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: default Pixoo 64 device IP for the "Send to Pixoo" button.
# PIXOO_HOST=192.168.1.100
